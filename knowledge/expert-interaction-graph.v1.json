  "escalation_rules": [
    {
      "when": "derived event reclassified after raw instruction audit",
      "to": [
        "event",
        "graph",
        "inventory",
        "statistics",
        "causal",
        "risk"
      ],
      "operation": "INVALIDATE_AFFECTED_DEPENDENTS_WITH_REASON"
    },
    {
      "when": "late event or provider coverage changed",
      "to": [
        "event",
        "statistics",
        "review"
      ],
      "operation": "REOPEN_WINDOW_RECALCULATE_AND_VERSION"
    },
    {
      "when": "public hub found in assumed same-control cluster",
      "to": [
        "graph",
        "adversarial",
        "statistics",
        "causal"
      ],
      "operation": "SPLIT_ENTITY_HYPOTHESES_RETEST_NEGATIVE_CONTROLS"
    },
    {
      "when": "market state defined using future price",
      "to": [
        "regime",
        "statistics",
        "execution",
        "review"
      ],
      "operation": "REMOVE_LEAKED_FEATURE_AND_REPLAY"
    },
    {
      "when": "causal hypothesis predicts value but no net positive after cost",
      "to": [
        "execution",
        "causal",
        "knowledge"
      ],
      "operation": "DOWNGRADE_TRADE_HYPOTHESIS_KEEP_MONITORING_MECHANISM"
    },
    {
      "when": "new behavior cannot be explained by current 17 expert disciplines",
      "to": [
        "chief",
        "knowledge",
        "data"
      ],
      "operation": "CREATE_OPEN_DOMAIN_PROPOSAL_WITH_PREDICTIONS"
    }
  ],
  "change_model": {
    "immutable_raw_events": true,
    "derived_claims_append_only_versions": true,
    "supersedes": "claim ID of older revision; never overwrite published conclusion silently",
    "propagation": "on retraction traverse depends_on_claim_ids to affected derived artifacts; recompute or mark contested",
    "control": "production monitoring rules remain unchanged until reviewed release"
  },
  "sources": [
    "https://www.w3.org/TR/prov-o/",
    "https://nightlies.apache.org/flink/flink-docs-stable/docs/learn-flink/streaming_analytics/",
    "https://opentelemetry.io/docs/specs/otel/overview/",
    "https://learn.microsoft.com/en-us/azure/architecture/ai-ml/guide/ai-agent-design-patterns/",
    "https://miguelhernan.org/whatifbook",
    "https://docs.jito.wtf/lowlatencytxnsend/"
  ]
}
