    {
      "id": "liquidity-depth",
      "title": "流动性变化不等于一定撤池",
      "status": "documented_legacy_method",
      "triggers": [
        "LIQUIDITY_DROP",
        "BASELINE"
      ],
      "keywords": [
        "流动性",
        "池子",
        "撤池",
        "lp",
        "滑点",
        "深度"
      ],
      "mechanism": "流动性变化值得调查退出能力、池子储备、价格冲击和LP控制，但估值变化或资金流动也能改变美元计价流动性。",
      "required_evidence": [
        "相同池、同一计价单位和采集时间",
        "LP add/remove交易",
        "两侧储备与价格",
        "链上流动性与路由深度"
      ],
      "alternative_explanations": [
        "SOL或Token价格变动造成USD估值变化",
        "正常再平衡/迁移",
        "行情API口径变化"
      ],
      "inference_limit": "只观察到liquidity_usd下降不能断言LP被抽走或人为rug。",
      "next_check": "将美元余额变化拆分为储备数量变化与价格变动，再核实LP事件。",
      "sources": [
