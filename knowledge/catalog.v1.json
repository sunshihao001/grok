    {
      "id": "concentration",
      "title": "Top10集中度变化需要区分地址与经济控制",
      "status": "documented_legacy_method",
      "triggers": [
        "TOP10_SHARE_RISE"
      ],
      "keywords": [
        "前十",
        "top10",
        "集中",
        "筹码",
        "持仓",
        "控盘"
      ],
      "mechanism": "Top holders 可描述地址层面的集中，不能证明经济主体集中。转账、供应量变化、池子地址混入和重复计量都会影响指标。",
      "required_evidence": [
        "供应量与持仓快照口径",
        "是否排除池子/CEX",
        "地址间转账",
        "同源与控制关系证据"
      ],
      "alternative_explanations": [
        "CEX/LP地址排名变化",
        "供应量分母变化",
        "正常鲸鱼买入"
      ],
      "inference_limit": "不能直接把top10变化解读为控盘、庄家或内幕。",
      "next_check": "验证holder样本与分母，再对疑似关联地址追加网络和历史分析。",
