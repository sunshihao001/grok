    {
      "id": "candidate-entry",
      "title": "市场候选的来源 ≠ 质量结论",
      "status": "source_contract",
      "triggers": [
        "BASELINE",
        "MISSING_FIELDS"
      ],
      "keywords": [
        "候选",
        "热度",
        "trending",
        "trenches",
        "signal",
        "新币"
      ],
      "mechanism": "先记录为什么进入视野。trending偏活跃，trenches偏早期，signal偏行为；任何一个都不能代表优质或安全。",
      "required_evidence": [
        "入口类型和筛选区间",
        "实际成交及时间戳",
        "池子和持有人结构"
      ],
      "alternative_explanations": [
        "刷量/批量钱包推高热度",
        "平台选择偏差",
        "本来就存在的正常市场关注"
      ],
      "inference_limit": "入口只负责发现，不能直接给交易或确定性质量判断。",
      "next_check": "对照同时间窗未入选样本，并核查市场来源、池子和主体。",
