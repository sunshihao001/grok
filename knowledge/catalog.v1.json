    {
      "id": "funding-graph",
      "title": "资金同源是关联线索，不等于同一个人",
      "status": "documented_legacy_method",
      "triggers": [
        "NEW_SOURCE_EVENT",
        "TOP10_SHARE_RISE"
      ],
      "keywords": [
        "同源",
        "资金",
        "追踪",
        "cluster",
        "关联钱包",
        "溯源",
        "资金循环"
      ],
      "mechanism": "把转入来源、时间、金额与后续交易连接成图。具有共享资金来源的群体值得审查，但群组可能只是共享交易所或基础设施。",
      "required_evidence": [
        "资金转账签名",
        "跳数和中转时间",
        "排除CEX/池子/托管基础设施",
        "后续协同行为"
      ],
      "alternative_explanations": [
        "共享CEX热钱包的无关用户",
        "代付或批量服务",
        "地址标签错误"
      ],
      "inference_limit": "不可把同一CEX提款地址视为单一控制者，也不可仅由两层转账证明控制权。",
      "next_check": "先排除基础设施，再做多线索关联与竞争解释。",
