    {
      "id": "wallet-roles",
      "title": "钱包角色由行为形成候选，不是实名身份",
      "status": "documented_legacy_method",
      "triggers": [
        "TOP10_SHARE_RISE",
        "NEW_SOURCE_EVENT"
      ],
      "keywords": [
