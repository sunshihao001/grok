        "smart money",
        "聪明钱",
        "deployer",
        "dev",
        "地址"
      ],
      "mechanism": "sniper/dev-linked/exit wallet等是行为候选。平台标签可做线索，但应由交易时序、部署历史、仓位变化及执行路径交叉验证。",
      "required_evidence": [
        "钱包交易签名与时间",
        "创建代币历史",
        "钱包资金流与持仓变化",
        "标签来源和定义"
      ],
      "alternative_explanations": [
        "标签过期或营销",
        "做市与路由地址",
        "机器人但不属于内部团体"
      ],
      "inference_limit": "早买、大仓位、smart money标签都不能单独证明内部人或盈利能力。",
      "next_check": "逐个钱包输出可复核事实、role_candidate、反证和无法验证之处。",
