    {
      "id": "token-security",
      "title": "权限和卖出限制风险是不同机制",
      "status": "documented_legacy_method",
      "triggers": [
        "BASELINE",
        "NEW_SOURCE_EVENT"
      ],
      "keywords": [
        "权限",
        "mint",
        "freeze",
        "honeypot",
        "rug",
        "安全"
      ],
      "mechanism": "mint/freeze authority、池子撤资、持仓集中抛售和路由/卖出失败属于不同风险机制，必须分别列证据。",
      "required_evidence": [
        "Mint/Token Program及权限状态",
        "池子变化",
        "实际失败交易及错误类型"
      ],
      "alternative_explanations": [
        "新账户标准/程序版本差异",
        "路由故障并非恶意限制",
        "市场深度不足"
      ],
      "inference_limit": "不可仅由单一平台安全标签断言 rug 或 honeypot。",
      "next_check": "区分链上权限、AMM流动性和交易路由失败类型。",
      "sources": [
