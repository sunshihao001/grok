    {
      "id": "creator-fee-economic-path",
      "title": "Creator Fee配置、累计与实际领取是三个不同经济状态",
      "status": "source_contract",
      "triggers": [
        "CREATOR_FEE",
        "FEE_WITHDRAWAL",
        "DEPLOYER_REVENUE"
      ],
      "keywords": [
        "Creator Fee",
        "开发者收益",
        "手续费",
        "fee accrual",
        "领取",
        "部署者资金"
      ],
      "mechanism": "发行者/Creator Fee的配置比例、交易产生的累计应计费用、可领取余额和实际提款是不同状态。只有追踪程序事件、权益归属、实际领取交易和后续资产路径，才能把费用收入纳入经济资本循环。",
      "required_evidence": [
        "协议和程序版本",
        "fee config与recipient变化",
        "fee accrual计算/账本来源",
        "claim/withdraw指令及签名",
        "recipient owner和后续资产流"
      ],
      "alternative_explanations": [
        "费用由协议/平台而非部署者取得",
        "费用仅累计但未领取",
        "接收地址是共享服务商或托管账户",
        "配置变更与实际可领取余额不一致"
      ],
      "inference_limit": "配置比例不等于已实现收入；提款地址不等于最终受益人；Creator Fee收益不自动证明买卖获利或操盘意图。",
      "next_check": "选定协议和部署案例，分别复算配置、应计、可领取、实际领取四个状态并查下游归集。",
