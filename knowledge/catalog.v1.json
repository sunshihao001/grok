    {
      "id": "multichannel-wallet-evidence",
      "title": "钱包群体需要多通道独立证据，而不是共享资金源加分",
      "status": "source_contract",
      "triggers": [
        "MULTICHANNEL_GROUP",
        "COORDINATION_CANDIDATE",
        "SHARED_FUNDER"
      ],
      "keywords": [
        "多通道钱包群",
        "协同",
        "共同买入",
        "共同卖出",
        "共同签名",
        "资金图",
        "token transfer",
        "群体"
      ],
      "mechanism": "将SOL funding、Token transfer、joint signer、co-buy、co-sell、shared receiver和跨Mint角色复用分成不同类型边，记录来源签名、时间、金额与来源依赖。先排除公共hub并检查巨型连通分量，再用保留钱包活跃度/资金度数的null或匹配对照验证群体结构。",
      "required_evidence": [
        "各通道原始事件和signature",
        "Token Account owner去重",
        "公共CEX/bridge/router/fee hub清单及覆盖",
        "同类协议/发行阶段/活跃度的基准总体",
        "跨Mint时间留出验证"
      ],
      "alternative_explanations": [
        "独立机器人响应同一公开刺激",
        "大量客户共用服务商/托管/交易所",
        "单一hub制造巨型连通分量",
        "同一程序模板被独立用户复用"
      ],
      "inference_limit": "共同funder、同Slot、Louvain社区或Token转账环均不单独证明共同受益人、Jito Bundle或wash trading。",
      "next_check": "构造多通道资产事实图与独立主体假设图，先剔除hub，再用匹配null检验群体在跨Mint留出集的稳定性。",
