      "id": "trade-direction-source-gate",
      "title": "BUY/SELL方向必须由源指令与资产变化确认",
      "status": "source_contract",
      "triggers": [
        "TRADE_DIRECTION_UNKNOWN",
        "BUY_SELL_SOURCE_CONFLICT",
        "SWAP_CLASSIFICATION"
      ],
      "keywords": [
        "BUY SELL",
        "买入卖出方向",
        "交易分类",
        "指令解码",
        "余额变化",
        "source gate"
      ],
      "mechanism": "供应商主标签、Token余额减少或SOL余额增加不能单独确定Swap方向。需要按程序/协议版本解析外内指令、交易账户、Token/SOL余额和池状态；无法分类时保留UNKNOWN，发现源标签污染则撤回依赖该标签的群体与收益统计。",
      "required_evidence": [
        "signature与instruction trace",
        "program id及版本",
        "Token/SOL pre/post balance",
        "池储备与Swap事件语义",
        "分层抽样复核与分类混淆矩阵"
      ],
      "alternative_explanations": [
        "真实Swap",
        "Token转移/销毁/LP操作",
        "CloseAccount/WSOL释放",
        "供应商把复合交易映射为主事件类型",
        "解析器不支持新程序"
      ],
      "inference_limit": "Token decrease不等于SELL；SOL increase不等于BUY资金源；未解码的事件不得进入协同买卖统计或收益标签。",
      "next_check": "按协议和场景分层抽样交易，人工RPC复算方向并估计错误传播范围。",
