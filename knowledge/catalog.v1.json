    {
      "id": "capital-role-invariance",
      "title": "地址轮换后仍可能保留经济角色序列，但必须排除公共工具模板",
      "status": "unverified_hypothesis",
      "triggers": [
        "CROSS_MINT_ROLE_REUSE",
        "CAMPAIGN_PATTERN",
        "ADDRESS_ROTATION"
      ],
      "keywords": [
        "地址轮换",
        "跨Mint重复",
        "角色不变量",
        "资本循环",
        "campaign",
        "操作网络"
      ],
      "mechanism": "把跨Mint研究单位从静态地址名单扩展为带时间的经济职责序列，例如资助、执行、库存接收、费用领取和资金再部署。即使地址轮换，角色拓扑和非公共资产路径可能持续；但共享launch工具、路由器和服务商也会产生表面相似。",
      "required_evidence": [
        "历史时点冻结的角色和资金路径",
        "多Mint签名级资产边",
        "实际Swap/LP/fee领取事件",
        "公共工具/服务商的负对照",
        "时间留出和未见地址的复现测试"
      ],
      "alternative_explanations": [
        "同一自动发币工具被大量独立用户复用",
        "公共路由/交易所/托管账户连接",
        "市场阶段相似造成重复时序",
        "地址相似但经济路径不连续"
      ],
      "inference_limit": "角色模式相似不证明同一操作者；只有非公共资产路径和可区分证据支持时，才提高同一经济网络假说。",
      "next_check": "冻结历史时点角色模板，在未见地址和未见Mint上测试拓扑复现，并与同平台独立发行对照。",
