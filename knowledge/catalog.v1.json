    {
      "id": "market-lifecycle",
      "title": "发行、迁移、建池、流动性阶段必须分别建模",
      "status": "documented_legacy_method",
      "triggers": [
        "BASELINE",
        "NEW_SOURCE_EVENT"
      ],
      "keywords": [
        "生命周期",
        "迁移",
        "pump.fun",
        "raydium",
        "建池",
        "migration"
      ],
      "mechanism": "新发币交易阶段与池子迁移后的流动性和数据可用性不同，不能把不同阶段指标直接混用。",
      "required_evidence": [
        "发行和池子创建交易",
        "路由/池状态",
        "阶段切换时间和来源"
      ],
      "alternative_explanations": [
        "平台索引延迟",
        "迁移之外的流动性调整"
      ],
      "inference_limit": "没有原始事件不能确认具体阶段。",
      "next_check": "比对池子状态、链上事件时序及不同源的时间粒度。",
      "sources": [
        {
          "repository": "sunshihao001/-",
          "commit": "2bf694b37cce25b4a3c9364298b784039f3ecc84",
          "path": "learning/05.md",
