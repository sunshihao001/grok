  "packs": [
    {
      "id": "KB-001",
      "version": "0.1.0",
      "stage": "reference_only",
      "path": "knowledge/packs/KB-001-evidence-bounds.md",
      "scope": "Evidence, fact-vs-inference, missing-data, and anti-hindsight interpretation. Not a predictive rule.",
      "source_ids": [
        "legacy-contract",
        "missing-data",
        "data-passport",
        "truth-map",
        "fcz",
        "reacceptance",
        "falsification"
      ],
      "triggers": [
        "SNAPSHOT",
        "LIQUIDITY_DROP",
        "TOP10_SHARE_RISE",
        "NEW_SOURCE_EVENT",
        "MISSING_DATA"
      ],
      "trigger_guidance": {
        "SNAPSHOT": {
          "interpretation": "单次快照只能证明来源报告的观测值；不能推出庄家身份、操纵动机或正期望。",
          "verify": "核对来源原始字段、单位、token mint、观测时间与同一池/同一口径。"
        },
        "LIQUIDITY_DROP": {
          "interpretation": "流动性指标下降是观测变化，不等同撤池、砸盘或死亡盘。",
          "verify": "复核池地址、报价币种、计价单位、时点；与其他池和真实链上流动性事件交叉核验。"
        },
        "TOP10_SHARE_RISE": {
          "interpretation": "前十持仓占比上升不等同同源钱包或筹码控制权增加。",
          "verify": "检查 token account/所有者映射、LP/CEX/合约账户排除、持仓分母变化及资金来源图。"
        },
        "NEW_SOURCE_EVENT": {
          "interpretation": "新事件 ID 是待核验事件线索；观察到标签不等于确认交易动机。",
          "verify": "关联链上交易签名、slot、地址归属、资金流和反例；排除重复采样。"
        },
        "MISSING_DATA": {
          "interpretation": "缺失字段是 UNKNOWN，不是 0；不能由上游缺失推断安全或确认。",
          "verify": "记录字段、来源命令、严重度、补采动作和下游决策上限。"
        }
      },
      "promote_only_after": "independent source/field verification + reproducible counterexamples + holdout/ablation + explicit human acceptance"
    },
    {
      "id": "KB-002",
      "version": "0.1.0",
      "stage": "reference_only",
      "path": "knowledge/packs/KB-002-wallet-funding-evidence.md",
