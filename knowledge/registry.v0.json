        "external-funder-null"
      ],
      "triggers": [
        "TOP10_SHARE_RISE",
        "NEW_SOURCE_EVENT",
        "MISSING_DATA"
      ],
      "trigger_guidance": {
        "TOP10_SHARE_RISE": {
          "interpretation": "集中度上升不证明钱包共控；owner/token-account/LP/PDA/CEX口径和时间快照必须独立审计。",
          "verify": "先确认 wallet->owner 映射与排除名单，再按截止时点读取原始转账签名、资金量和可见时间。"
        },
        "NEW_SOURCE_EVENT": {
          "interpretation": "共同转入或同步交易是关系候选，不等于同一实际控制人；共享服务和粉尘可制造伪关联。",
          "verify": "核对方向、金额、独立签名与指令索引、网络中心度、服务地址、对照组以及样本外稳定性。"
        },
        "MISSING_DATA": {
          "interpretation": "缺失交易页、RPC失败、过早截断或错误的源地址归属，会使未发现关系成为未知而非无关系。",
          "verify": "保留覆盖率/异常原因，列出未读地址与起止窗口；重新采集前输出 NEED_MORE_DATA。"
        }
      },
      "promote_only_after": "live chain source equivalence + verified owner and hub labels + representative controls + blind holdout + human review; no identity attribution"
    }
  ]
