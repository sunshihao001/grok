    {
      "id": "evidence-synthesis",
      "title": "证据链、反证与缺失证据独立呈现",
      "status": "source_contract",
      "triggers": [
        "BASELINE",
        "MISSING_FIELDS",
        "LIQUIDITY_DROP",
        "TOP10_SHARE_RISE",
        "NEW_SOURCE_EVENT"
      ],
      "keywords": [
        "证据",
        "反证",
        "冲突",
        "判断",
        "机制",
        "分析",
        "为什么"
      ],
      "mechanism": "来源事实、角色假说、机制推断、竞争解释不能混成一个确定性评分。保留时效性和不可用字段。",
      "required_evidence": [
        "各判断的原始来源与时间",
        "支持与反驳证据",
        "未观测的关键变量"
      ],
      "alternative_explanations": [
        "同一数据来源重复计为多个独立证据",
        "相关而非因果",
